---
import Base from '../layouts/Base.astro';
import PageBanner from '../components/PageBanner.astro';
import Postmark from '../components/Postmark.astro';
import { LIMITS, SITE } from '../lib/config.ts';
import { todayInShap } from '../lib/rounds.ts';

const today = todayInShap();
---
<Base
  title="Log your round"
  description="Add your walk or run of the Shap postal round to the round book, and see who else has done it."
>
  <main id="main">
    <PageBanner
      page="log"
      title="Log your round"
      kicker="The round book"
      lede="Walked it or ran it? Put your name in the round book."
    />
    <section class="steps-band" aria-labelledby="how-h">
      <div class="wrap">
        <p class="label-kicker">Not a race, but…</p>
        <h2 id="how-h">How it works</h2>
        <ol class="steps">
          <li>
            <span class="step-n" aria-hidden="true">1</span>
            <h3>Record it</h3>
            <p>Walk or run the round with any free GPS app: Strava, Garmin Connect, OS Maps, Komoot or similar.</p>
          </li>
          <li>
            <span class="step-n" aria-hidden="true">2</span>
            <h3>Send it in</h3>
            <p>Upload your GPX and we check it on the spot. No GPX? Add an activity link or a photo from the Thorney Bank postbox.</p>
          </li>
          <li>
            <span class="step-n" aria-hidden="true">3</span>
            <h3>Take your place</h3>
            <p>You’re in the round book straight away. Checked rounds count towards the fastest times.</p>
          </li>
        </ol>
      </div>
    </section>

    <section id="log" class="form-section">
      <div class="wrap log">
        <div class="measure">
          <p class="label-kicker">Your round</p>
          <h2>Add your name to the book</h2>
          <p>
            Your name, date and time appear in the public round book. Your GPX file and photo are only used to check your
            round and are never shown to others.
          </p>
          <Postmark class="log-postmark" line="ROUND BOOK" year="2026" />
        </div>

        <form id="f" novalidate>
          <div class="field">
            <label for="name">Your name <span class="hint">(or a nickname)</span></label>
            <input id="name" name="name" type="text" maxlength={LIMITS.nameMax} autocomplete="name" required />
          </div>
          <div class="field">
            <span class="label" id="roundlbl">Which round?</span>
            <div class="seg" role="radiogroup" aria-labelledby="roundlbl">
              <label><input type="radio" name="round" value="long" checked /><span>Long round</span></label>
              <label><input type="radio" name="round" value="short" /><span>Short round</span></label>
            </div>
          </div>
          <div class="field">
            <span class="label" id="modelbl">How did you do it?</span>
            <div class="seg" role="radiogroup" aria-labelledby="modelbl">
              <label><input type="radio" name="mode" value="walk" checked /><span>Walked</span></label>
              <label><input type="radio" name="mode" value="run" /><span>Ran</span></label>
            </div>
          </div>
          <div class="field">
            <label for="gpx">GPX file <span class="hint">(recommended)</span></label>
            <div class="drop">
              <input id="gpx" type="file" accept=".gpx,application/gpx+xml,application/xml,text/xml" />
              <div class="gpxresult" id="gpxres" aria-live="polite"></div>
            </div>
          </div>
          <div class="row">
            <div class="field">
              <label for="date">Date</label>
              <input id="date" name="date" type="date" required max={today} min={LIMITS.earliestDate} />
            </div>
            <div class="field">
              <span class="label" id="timelbl">Time taken</span>
              <div class="time" role="group" aria-labelledby="timelbl">
                <input id="hh" name="hours" type="text" inputmode="numeric" maxlength="2" placeholder="h" aria-label="Hours" />:
                <input id="mm" name="minutes" type="text" inputmode="numeric" maxlength="2" placeholder="mm" aria-label="Minutes" />
              </div>
            </div>
          </div>
          <div class="field">
            <label for="link">Activity link <span class="hint">(optional)</span></label>
            <input id="link" name="link" type="url" maxlength={LIMITS.linkMax} placeholder="https://www.strava.com/activities/…" />
          </div>
          <div class="field">
            <label for="photo">Photo evidence <span class="hint">(optional)</span></label>
            <input id="photo" type="file" accept="image/jpeg,image/png,image/webp" />
          </div>
          <div class="field">
            <label for="note">A line for the round book <span class="hint">(optional)</span></label>
            <textarea id="note" name="note" rows="2" maxlength={LIMITS.noteMax} placeholder="Snow on Glede Howe, tea at Birchwood after"></textarea>
          </div>
          <div class="field">
            <label class="consent" for="consent">
              <input id="consent" name="consent" type="checkbox" value="yes" required />
              <span>I’m happy for my name, round, date, time, link and note to appear in the public round book.</span>
            </label>
          </div>
          <div class="hp" aria-hidden="true">
            <label for="website">Leave this empty</label>
            <input id="website" name="website" type="text" tabindex="-1" autocomplete="off" />
          </div>
          <button class="btn red" type="submit" id="submit">Add my round</button>
          <div class="msg" id="msg" role="status" aria-live="polite"></div>
        </form>
      </div>
    </section>

    <section id="board" class="board-section">
      <div class="wrap">
        <p class="label-kicker">Who’s done it</p>
        <h2>The round book</h2>
        <div class="board-head">
          <p style="margin:0" id="count">Everyone who has completed the Shap round, newest first.</p>
          <div class="round-filter tabs" id="roundfilter" role="group" aria-label="Which round" hidden>
            <button type="button" data-round="long" aria-pressed="true">Long round</button>
            <button type="button" data-round="short" aria-pressed="false">Short round</button>
          </div>
          <div class="tabs" role="group" aria-label="Sort leaderboard">
            <button type="button" data-view="date" aria-pressed="true">By date</button>
            <button type="button" data-view="run" aria-pressed="false">Fastest runs</button>
            <button type="button" data-view="walk" aria-pressed="false">Fastest walks</button>
          </div>
        </div>
        <div class="tablewrap">
          <table>
            <thead>
              <tr><th scope="col">#</th><th scope="col">Name</th><th scope="col">Date</th><th scope="col">Time</th><th scope="col">Evidence</th></tr>
            </thead>
            <tbody id="rows"></tbody>
          </table>
          <div class="empty" id="empty">Loading the round book…</div>
        </div>
      </div>
    </section>

    <section id="pin" class="band-fell tight" aria-labelledby="pin-h">
      <div class="wrap"><div class="measure">
        <h2 id="pin-h">Your finisher’s pin</h2>
        {
          SITE.pinsAvailable ? (
            <p>
              Finisher’s pins are collected in person at Birchwood Cafe. Bring your finisher photo, buy a brew and a
              bite, and have your cake and eat it.
            </p>
          ) : (
            <p>
              Finisher’s pins are on their way. Once they’re in, you’ll collect yours in person at Birchwood Cafe with
              your finisher photo.
            </p>
          )
        }
      </div>
      </div>
    </section>
  </main>
</Base>

<script>
  import '../scripts/log.ts';
</script>

<style>
  .steps-band { border-top: 0; padding-top: clamp(3rem, 6vw, 4.5rem); }
  .steps { list-style: none; margin: 1.5rem 0 0; padding: 0; display: grid; grid-template-columns: repeat(3, 1fr); gap: 1.2rem; }
  .steps li { position: relative; background: var(--card); border: 1px solid var(--line); border-radius: 12px; padding: 1.6rem 1.4rem 1.3rem; }
  .steps .step-n {
    display: grid; place-items: center; width: 2.6rem; height: 2.6rem; border-radius: 50%;
    background: var(--red); color: #fff; font-family: var(--serif); font-weight: 800; font-size: 1.2rem; margin-bottom: 0.9rem;
  }
  .steps h3 { color: var(--fell); font-weight: 800; margin-bottom: 0.4rem; }
  .steps p { margin: 0; color: var(--ink-soft); }
  .form-section { background: var(--paper-2); }
  :global(.log-postmark) { position: static !important; display: block; width: 130px; height: 130px; color: var(--red); opacity: 0.8; transform: rotate(-12deg); margin-top: 1.5rem; }
  :global(form#f) { box-shadow: 0 18px 44px rgba(20, 30, 18, 0.1); border-radius: 12px; background: var(--paper); }
  @media (max-width: 820px) {
    .steps { grid-template-columns: 1fr; }
    :global(.log-postmark) { display: none; }
  }
</style>
