---
/** Home page. Visual language from reference/shap-postal-round.html; content per docs/build-brief.md. */
import Base from '../layouts/Base.astro';
import Hero from '../components/Hero.astro';
import IntroBand from '../components/IntroBand.astro';
import StacyStory from '../components/StacyStory.astro';
import PostYourRound from '../components/PostYourRound.astro';
import InstagramStrip from '../components/InstagramStrip.astro';
import Photo from '../components/Photo.astro';
import { ROUNDS } from '../lib/config.ts';
import { GALLERY } from '../lib/photos.ts';
---
<Base
  description="Walk or run the old Shap postman's round: a heritage route through Swindale and Wet Sleddale on the eastern edge of the Lake District, starting and finishing at Birchwood Cafe."
>
  <main id="main">
    <Hero />

    <IntroBand />

    <StacyStory />

    <section class="jude" aria-labelledby="why-h">
      <div class="wrap jude-grid">
        <div class="jude-note">
          <h2 id="why-h">Keeping the round on the go</h2>
          <p class="jude-big">
            “Since moving here five years ago it has become a regular running route for me and many local fell runners. It
            seemed obvious to us to share the opportunity to explore some of the Lake District’s most remote and rarely
            visited eastern fells, and also keep this historic round on the go.”
          </p>
          <p>
            “The route can be enjoyed as a leisurely or social run, but if you’re really up for it, you could take on the
            postman’s challenge and add your name and time to the <a href="/round-book/">round book</a>.”
          </p>
          <p class="sig">Jude, Shap fell runner</p>
        </div>
        <div class="jude-side">
          <a class="book-card cafe-card" href="/birchwood-cafe/">
            <strong>Start at Birchwood Cafe</strong>
            Fill your bottles over the old post office counter, check your time against the old post office clock, and come
            back for cake.
            <span class="more">About the café →</span>
          </a>
          <h3>Two rounds, one start</h3>
          <p>
            <strong>{ROUNDS.long.name}</strong> is about {ROUNDS.long.miles} miles with 600 metres of climb, taking in the
            shepherd’s cottage at Mosedale. <strong>{ROUNDS.short.name}</strong> is about{' '}
            {ROUNDS.short.miles} miles, over the postie’s shortcut on Ralfland Fell.
          </p>
        </div>
      </div>
    </section>

    <section class="gallery-section" aria-labelledby="gallery-h">
      <div class="wrap">
        <h2 id="gallery-h">The round in pictures</h2>
        <p class="measure">Frosty abbey mornings, Swindale’s waterfalls, snow on the old tracks and long summer evenings on the fell.</p>
        <div class="gallery">
          {GALLERY.map((p, i) => <Photo photo={p} class={`g${i}`} sizes="(min-width: 900px) 33vw, (min-width: 560px) 50vw, 100vw" />)}
        </div>
      </div>
    </section>

    <PostYourRound />

    <section aria-labelledby="plan-h">
      <div class="wrap">
        <h2 id="plan-h">Plan your round</h2>
        <div class="cards">
          <a class="card" href="/route/">
            <h3>The route</h3>
            <p>Both rounds, stop by stop, with GPX downloads and current notices.</p>
            <p class="more">See the route →</p>
          </a>
          <a class="card" href="/safety/">
            <h3>Safety &amp; respect</h3>
            <p>Rough, pathless, unwaymarked fell. What to take, and how to look after the land.</p>
            <p class="more">Before you go →</p>
          </a>
          <a class="card" href="/round-book/">
            <h3>The round book</h3>
            <p>Fastest times overall, by category and by age group. Done it? Post your round and take your place.</p>
            <p class="more">See the leaderboard →</p>
          </a>
        </div>
      </div>
    </section>

    <InstagramStrip />
  </main>
</Base>

<style>
  .jude-grid { display: grid; grid-template-columns: 1.25fr 1fr; gap: clamp(2rem, 5vw, 4rem); align-items: start; }
  .jude-note h2 { color: var(--fell); }
  .jude-big { font-family: var(--serif); font-weight: 600; font-size: clamp(1.25rem, 2.2vw, 1.55rem); line-height: 1.4; letter-spacing: -0.01em; }
  .sig { font-family: var(--serif); font-weight: 700; color: var(--red); margin-top: 1.2rem; }
  .sig::before { content: '— '; }
  .cafe-card { display: block; text-decoration: none; }
  .cafe-card .more { display: block; margin-top: 1rem; font-weight: 700; color: #fff; }
  .cafe-card:hover { filter: brightness(1.08); }
  .jude-side h3 { margin-top: 2rem; color: var(--fell); }
  @media (max-width: 820px) { .jude-grid { grid-template-columns: 1fr; } }
</style>
