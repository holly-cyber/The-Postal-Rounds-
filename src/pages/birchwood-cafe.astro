---
import ContentPage from '../components/ContentPage.astro';
import InstagramStrip from '../components/InstagramStrip.astro';
import Postmark from '../components/Postmark.astro';
---
<ContentPage id="cafe" kicker="Start and finish" banner="cafe">
  <aside slot="before" class="stamp tilt cafe-stamp" aria-label="Opening times">
    <Postmark line="START HERE" year="SHAP" />
    <p class="stamp-label">Find us</p>
    <h3>Main Street, Shap</h3>
    <p>CA10 3NJ</p>
    <p><strong>Usually open</strong><br />Tuesday to Saturday, 9am to 4pm</p>
    <p class="hint">Walker, cyclist, dog and child friendly.</p>
  </aside>
  <InstagramStrip slot="after" />
</ContentPage>

<style>
  .cafe-stamp { float: right; width: min(22rem, 100%); margin: 0 0 2rem 2.5rem; }
  .cafe-stamp h3 { color: var(--fell); font-weight: 800; font-size: 1.5rem; margin: 0 0 0.2rem; max-width: 70%; }
  .cafe-stamp p { margin: 0 0 0.8rem; }
  :global(.cafe-stamp .postmark) { width: 90px; height: 90px; color: #c4241c; opacity: 0.8; transform: rotate(-14deg); }
  @media (max-width: 820px) { .cafe-stamp { float: none; margin: 0 0 2rem; } .cafe-stamp.tilt { transform: none; } }
</style>
