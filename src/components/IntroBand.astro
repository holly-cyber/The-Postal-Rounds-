---
/**
 * Home page intro: the Stuart Lewis quote as the centrepiece on a fell-green band,
 * with the route facts on a postage-stamp card.
 */
import { ROUNDS } from '../lib/config.ts';

const tiles: [string, string, string][] = [
  [`${ROUNDS.long.km}`, 'km', 'long round'],
  [`${ROUNDS.short.km}`, 'km', 'short “winter” round'],
  ['600', 'm', 'of climb'],
  ['3–3½', 'hrs', 'at a steady run'],
];
const details: [string, string][] = [
  ['Start & finish', 'Birchwood Cafe, Main Street, Shap · NY 56268 15254'],
  ['Walking', 'Allow a full day. Tough in places.'],
  ['Terrain', 'Fields, lanes and rough, often pathless fell'],
  ['Map', 'OS Explorer OL5 and a compass'],
];
---
<section id="intro" class="intro-band" aria-labelledby="intro-h">
  <div class="wrap intro-grid">
    <div class="intro-story">
      <p class="intro-kicker">The challenge</p>
      <h2 id="intro-h">Tougher than it looks.</h2>
      <p class="intro-lede">
        Traversing three remote Lake District valleys, the round will leave you with nothing but respect for the village
        postie.
      </p>

      <figure class="bigquote">
        <span class="qmark" aria-hidden="true">“</span>
        <blockquote>
          <p>
            It broke my heart. I loved the walk and went out in all weathers. There wasn’t a day when we didn’t complete
            the round even in mist, snow and ice.
          </p>
        </blockquote>
        <figcaption>
          <strong>Stuart Lewis</strong>
          <span>The last postman to walk the round, on being given a van in 1976</span>
        </figcaption>
      </figure>

      <a class="intro-link" href="/story/">Read the story of the round <span aria-hidden="true">→</span></a>
    </div>

    <aside class="stamp" aria-labelledby="glance-h">
      <svg class="postmark" viewBox="0 0 120 120" aria-hidden="true">
        <defs>
          <path id="pm-ring" d="M60 60 m-44 0 a44 44 0 1 1 88 0 a44 44 0 1 1 -88 0" />
        </defs>
        <circle cx="60" cy="60" r="56" fill="none" stroke="currentColor" stroke-width="2.5" />
        <circle cx="60" cy="60" r="33" fill="none" stroke="currentColor" stroke-width="1.5" />
        <text font-size="11" font-weight="700" letter-spacing="2.2" fill="currentColor">
          <textPath href="#pm-ring">SHAP · WESTMORLAND · CUMBRIA ·</textPath>
        </text>
        <text x="60" y="57" text-anchor="middle" font-size="9" font-weight="700" fill="currentColor">LAST ROUND</text>
        <text x="60" y="73" text-anchor="middle" font-size="17" font-weight="800" fill="currentColor">1976</text>
      </svg>

      <h3 id="glance-h">Route at a glance</h3>
      <dl class="tiles">
        {
          tiles.map(([n, u, l]) => (
            <div>
              <dt>{l}</dt>
              <dd>
                {n}
                <small>{u}</small>
              </dd>
            </div>
          ))
        }
      </dl>
      <dl class="details">
        {
          details.map(([k, v]) => (
            <div>
              <dt>{k}</dt>
              <dd>{v}</dd>
            </div>
          ))
        }
      </dl>
      <a class="btn red stamp-cta" href="/route/">See the route</a>
    </aside>
  </div>
</section>

<style>
  .intro-band {
    position: relative;
    background:
      radial-gradient(ellipse 70% 90% at 0% 0%, rgba(111, 139, 63, 0.35), transparent 60%),
      linear-gradient(160deg, #2e4a2b 0%, #1f331d 100%);
    color: #eef1e8;
    border-top: 0;
    padding: clamp(4rem, 9vw, 6.5rem) 0;
    overflow: hidden;
  }
  /* A faint contour-line texture, like an OS map. */
  .intro-band::before {
    content: '';
    position: absolute;
    inset: 0;
    opacity: 0.09;
    background-image: repeating-radial-gradient(circle at 85% 110%, transparent 0 22px, #eef1e8 22px 23px);
    pointer-events: none;
  }
  .intro-grid {
    position: relative;
    display: grid;
    grid-template-columns: 1.15fr 1fr;
    gap: clamp(2.5rem, 6vw, 5rem);
    align-items: center;
  }
  .intro-kicker {
    font-family: var(--sans);
    font-weight: 700;
    font-size: 0.8rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: #ff8f86;
    margin-bottom: 0.8rem;
  }
  .intro-story h2 {
    color: #fff;
    font-size: clamp(2.1rem, 4.4vw, 3.1rem);
    font-weight: 800;
    margin-bottom: 0.5em;
  }
  .intro-lede { font-size: 1.15rem; color: #d7dfcf; max-width: 34rem; }

  .bigquote { position: relative; margin: 3.6rem 0 2rem; padding-left: 0.2rem; }
  .qmark {
    position: absolute;
    top: -3.2rem;
    left: -0.6rem;
    font-family: var(--serif);
    font-weight: 800;
    font-size: 9rem;
    line-height: 1;
    color: #c4241c;
    opacity: 0.95;
  }
  .bigquote blockquote { margin: 0; }
  .bigquote blockquote p {
    position: relative;
    font-family: var(--serif);
    font-weight: 600;
    font-size: clamp(1.35rem, 2.4vw, 1.75rem);
    line-height: 1.35;
    letter-spacing: -0.01em;
    color: #fff;
    margin: 0;
  }
  .bigquote figcaption { display: flex; flex-direction: column; margin-top: 1.1rem; font-family: var(--sans); }
  .bigquote figcaption strong { color: #fff; font-size: 1rem; }
  .bigquote figcaption span { color: #b9c4b1; font-size: 0.92rem; }
  .intro-link { color: #fff; font-weight: 600; text-decoration: none; border-bottom: 2px solid #c4241c; padding-bottom: 2px; }
  .intro-link:hover { color: #ffd9d4; }
  .intro-band :focus-visible { outline-color: #fff; }

  /* Postage-stamp card */
  .stamp {
    position: relative;
    background: #fbfaf5;
    color: #1a2019;
    padding: 2.2rem 2rem 1.9rem;
    transform: rotate(1.5deg);
    box-shadow: 0 24px 60px rgba(0, 0, 0, 0.35);
    /* Perforated edges: bites along the border, with the inner area kept solid. */
    -webkit-mask:
      radial-gradient(circle 6px at 50% 50%, transparent 97%, #000) -9px -9px / 18px 18px round,
      linear-gradient(#000 0 0) center / calc(100% - 18px) calc(100% - 18px) no-repeat;
    mask:
      radial-gradient(circle 6px at 50% 50%, transparent 97%, #000) -9px -9px / 18px 18px round,
      linear-gradient(#000 0 0) center / calc(100% - 18px) calc(100% - 18px) no-repeat;
  }
  .stamp::before {
    content: '';
    position: absolute;
    inset: 16px;
    border: 1.5px solid #c9d1bd;
    pointer-events: none;
  }
  .postmark {
    position: absolute;
    top: 0.6rem;
    right: 0.6rem;
    width: 96px;
    height: 96px;
    color: #c4241c;
    opacity: 0.85;
    transform: rotate(-14deg);
    font-family: var(--sans);
  }
  .stamp h3 {
    font-size: 0.85rem;
    font-family: var(--sans);
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: #2e4a2b;
    margin: 0.4rem 0 2.2rem;
  }
  .tiles { display: grid; grid-template-columns: 1fr 1fr; gap: 1.2rem 1rem; margin: 0 0 1.4rem; position: relative; }
  .tiles div { display: flex; flex-direction: column; }
  .tiles dd {
    order: -1;
    margin: 0;
    font-family: var(--serif);
    font-weight: 800;
    font-size: clamp(2rem, 4vw, 2.6rem);
    line-height: 1;
    letter-spacing: -0.02em;
    color: #2e4a2b;
  }
  .tiles dd small { font-size: 0.45em; font-weight: 700; margin-left: 0.15em; color: #6f8b3f; letter-spacing: 0; }
  .tiles dt { font-size: 0.88rem; color: #4f5a4b; margin-top: 0.3rem; }
  .details { margin: 0 0 1.5rem; border-top: 1.5px dashed #c9d1bd; position: relative; }
  .details div { display: grid; grid-template-columns: 7.5rem 1fr; gap: 0.8rem; padding: 0.6rem 0; border-bottom: 1px solid #e6eadf; font-size: 0.95rem; }
  .details dt { color: #4f5a4b; }
  .details dd { margin: 0; font-weight: 600; }
  .stamp-cta { position: relative; }

  @media (max-width: 900px) {
    .intro-grid { grid-template-columns: 1fr; }
    .stamp { transform: none; max-width: 30rem; }
  }
  @media (max-width: 420px) {
    .stamp { padding: 2rem 1.3rem 1.6rem; }
    .postmark { width: 92px; height: 92px; }
    .details div { grid-template-columns: 1fr; gap: 0.1rem; }
  }
</style>
