---
import Base from '../layouts/Base.astro';
import PageBanner from '../components/PageBanner.astro';
import Postmark from '../components/Postmark.astro';
import { LIMITS, SITE } from '../lib/config.ts';
import { AGE_GROUPS, todayInShap } from '../lib/rounds.ts';

const today = todayInShap();
---
<Base
  title="Post your round"
  description="Finished the Shap postal round? Post your round into the round book, just as the posties handed in the day’s post."
>
  <main id="main">
    <PageBanner
      page="log"
      title="Post your round"
      kicker="The round book"
      lede="Every postie’s day ended back in Shap with the round done. Yours ends the same way: post your round and it’s delivered straight into the round book."
    />
    <section class="steps-band" aria-labelledby="how-h">
      <div class="wrap">
        <p class="label-kicker">Not a race, but…</p>
        <h2 id="how-h">From the fell to the round book</h2>
        <ol class="steps">
          <li>
            <span class="step-n" aria-hidden="true">1</span>
            <h3>Do the round</h3>
            <p>Walk or run it with any free GPS app recording: Strava, Garmin Connect, OS Maps, Komoot or similar.</p>
          </li>
          <li>
            <span class="step-n" aria-hidden="true">2</span>
            <h3>Post it</h3>
            <p>Fill in the form below and attach your GPX. No GPX? Add an activity link or a photo from the Thorney Bank postbox.</p>
          </li>
          <li>
            <span class="step-n" aria-hidden="true">3</span>
            <h3>Franked and delivered</h3>
            <p>We check your GPX on the spot and your round lands in the book straight away. Checked rounds count towards the fastest times.</p>
          </li>
        </ol>
      </div>
    </section>

    <section id="post" class="form-section">
      <div class="wrap log">
        <div class="measure">
          <p class="label-kicker">Your round</p>
          <h2>Addressed to the round book</h2>
          <p>
            Your name, date and time appear in the public round book. Your GPX file and photo are only used to check your
            round and are never shown to others.
          </p>
          <Postmark class="log-postmark" line="ROUND BOOK" year="2026" />
        </div>

        <form id="f" novalidate>
          <div class="field">
            <label for="name">Your name <span class="hint">(or a nickname)</span></label>
            <input id="name" name="name" type="text" maxlength={LIMITS.nameMax} autocomplete="name" required />
          </div>
          <div class="field">
            <span class="label" id="roundlbl">Which round?</span>
            <div class="seg" role="radiogroup" aria-labelledby="roundlbl">
              <label><input type="radio" name="round" value="long" checked /><span>Long round</span></label>
              <label><input type="radio" name="round" value="short" /><span>Short round</span></label>
            </div>
          </div>
          <div class="field">
            <span class="label" id="modelbl">How did you do it?</span>
            <div class="seg" role="radiogroup" aria-labelledby="modelbl">
              <label><input type="radio" name="mode" value="walk" checked /><span>Walked</span></label>
              <label><input type="radio" name="mode" value="run" /><span>Ran</span></label>
            </div>
          </div>
          <div class="row">
            <div class="field">
              <label for="sex">Category <span class="hint">(optional)</span></label>
              <select id="sex" name="sex" aria-describedby="cat-help">
                <option value="">Prefer not to say</option>
                <option value="F">Female</option>
                <option value="M">Male</option>
              </select>
            </div>
            <div class="field">
              <label for="ageGroup">Age group <span class="hint">(optional)</span></label>
              <select id="ageGroup" name="ageGroup" aria-describedby="cat-help">
                <option value="">Prefer not to say</option>
                {AGE_GROUPS.map(([v, l]) => <option value={v}>{l}</option>)}
              </select>
            </div>
          </div>
          <p class="hint" id="cat-help" style="margin:-0.4rem 0 1rem">
            Used for the round book’s category tables. Age on the day of your round. Leave blank to appear in Overall only.
          </p>
          <div class="field">
            <span class="label">Your GPX file <span class="hint">(recommended)</span></span>
            <label class="postbox" id="postbox" for="gpx">
              <input id="gpx" class="postbox-input" type="file" accept=".gpx,application/gpx+xml,application/xml,text/xml" aria-describedby="gpx-help" />
              <span class="postbox-plate" aria-hidden="true">SHAP</span>
              <span class="postbox-slot" aria-hidden="true"><span class="postbox-letter"></span></span>
              <span class="postbox-text">
                <strong id="gpx-title">Drop your GPX in the postbox</strong>
                <span id="gpx-help">or tap to choose a file. We’ll check it on the spot.</span>
              </span>
            </label>
            <div class="gpxresult" id="gpxres" aria-live="polite"></div>
          </div>
          <div class="row when">
            <div class="field">
              <label for="date">Date</label>
              <input id="date" name="date" type="date" required max={today} min={LIMITS.earliestDate} aria-describedby="date-help" />
              <span class="hint" id="date-help">Tap to choose the day you did it</span>
            </div>
            <div class="field">
              <span class="label" id="timelbl">Time taken <span class="hint">(total, start to finish)</span></span>
              <div class="time" role="group" aria-labelledby="timelbl">
                <input id="hh" name="hours" type="text" inputmode="numeric" maxlength="2" placeholder="h" aria-label="Hours" />:
                <input id="mm" name="minutes" type="text" inputmode="numeric" maxlength="2" placeholder="mm" aria-label="Minutes" />
              </div>
            </div>
          </div>
          <div class="field">
            <label for="link">Activity link <span class="hint">(optional)</span></label>
            <input id="link" name="link" type="url" maxlength={LIMITS.linkMax} placeholder="https://www.strava.com/activities/…" />
          </div>
          <div class="field">
            <label for="photo">Photo evidence <span class="hint">(optional: a selfie at the Thorney Bank postbox is perfect)</span></label>
            <input id="photo" type="file" accept="image/jpeg,image/png,image/webp" />
            <figure class="snap" id="snap" hidden>
              <img id="snap-img" alt="Your chosen photo" />
            </figure>
          </div>
          <div class="field">
            <label for="note">A line for the round book <span class="hint">(optional)</span></label>
            <textarea id="note" name="note" rows="2" maxlength={LIMITS.noteMax} placeholder="Snow on Glede Howe, tea at Birchwood after"></textarea>
          </div>
          <div class="field">
            <label class="consent" for="consent">
              <input id="consent" name="consent" type="checkbox" value="yes" required />
              <span>I’m happy for my name, round, category, age group, date, time, link and note to appear in the public round book.</span>
            </label>
          </div>
          <div class="hp" aria-hidden="true">
            <label for="website">Leave this empty</label>
            <input id="website" name="website" type="text" tabindex="-1" autocomplete="off" />
          </div>
          <button class="btn red" type="submit" id="submit">Post my round</button>
          <div class="msg" id="msg" role="status" aria-live="polite"></div>
        </form>

        <div class="posted" id="posted" hidden tabindex="-1" aria-labelledby="posted-h">
          <div class="posted-scene" aria-hidden="true">
            <div class="chute"><div class="posted-letter"><span></span></div></div>
            <div class="pillar"><span class="pillar-slot"></span><span class="pillar-plate">SHAP</span></div>
            <div class="posted-frank"><span>SHAP</span><strong>DELIVERED</strong><span id="posted-year"></span></div>
          </div>
          <p class="label-kicker">Posted and delivered</p>
          <h2 id="posted-h">You’re in the round book</h2>
          <p id="posted-text"></p>
          <p class="posted-actions">
            <a class="btn red" id="posted-link" href="/round-book/">Find yourself in the round book</a>
            <button type="button" class="btn ghost" id="post-another">Post another round</button>
          </p>
        </div>
      </div>
    </section>

    <section class="rb-cta" aria-labelledby="rb-h">
      <div class="wrap rb-cta-inner">
        <div>
          <p class="label-kicker">Who’s done it</p>
          <h2 id="rb-h">See the round book</h2>
          <p>Fastest times overall, by category and by age group, for walkers and runners on both rounds.</p>
        </div>
        <a class="btn red" href="/round-book/">Open the round book</a>
      </div>
    </section>

    <section id="pin" class="band-fell tight" aria-labelledby="pin-h">
      <div class="wrap"><div class="measure">
        <h2 id="pin-h">Your finisher’s pin</h2>
        {
          SITE.pinsAvailable ? (
            <p>
              Finisher’s pins are collected in person at Birchwood Cafe. Bring your finisher photo, buy a brew and a
              bite, and have your cake and eat it.
            </p>
          ) : (
            <p>
              Finisher’s pins are on their way. Once they’re in, you’ll collect yours in person at Birchwood Cafe with
              your finisher photo.
            </p>
          )
        }
      </div>
      </div>
    </section>
  </main>
</Base>

<script>
  import '../scripts/log.ts';
</script>

<style>
  .steps-band { border-top: 0; padding-top: clamp(3rem, 6vw, 4.5rem); }
  .steps { list-style: none; margin: 1.5rem 0 0; padding: 0; display: grid; grid-template-columns: repeat(3, 1fr); gap: 1.2rem; }
  .steps li { position: relative; background: var(--card); border: 1px solid var(--line); border-radius: 12px; padding: 1.6rem 1.4rem 1.3rem; }
  .steps .step-n {
    display: grid; place-items: center; width: 2.6rem; height: 2.6rem; border-radius: 50%;
    background: var(--red); color: #fff; font-family: var(--serif); font-weight: 800; font-size: 1.2rem; margin-bottom: 0.9rem;
  }
  .steps h3 { color: var(--fell); font-weight: 800; margin-bottom: 0.4rem; }
  .steps p { margin: 0; color: var(--ink-soft); }
  .form-section { background: var(--paper-2); }
  :global(form#f select) { width: 100%; font: inherit; font-size: 1rem; padding: 0.6rem 0.7rem; border: 1.5px solid var(--line); border-radius: 4px; background: var(--paper); color: var(--ink); }
  .rb-cta-inner { display: flex; flex-wrap: wrap; gap: 1.5rem; align-items: center; justify-content: space-between; }
  .rb-cta-inner p:last-child { margin: 0; }
  :global(.log-postmark) { position: static !important; display: block; width: 130px; height: 130px; color: var(--red); opacity: 0.8; transform: rotate(-12deg); margin-top: 1.5rem; }
  :global(form#f) { box-shadow: 0 18px 44px rgba(20, 30, 18, 0.1); border-radius: 12px; background: var(--paper); }
  @media (max-width: 820px) {
    .steps { grid-template-columns: 1fr; }
    :global(.log-postmark) { display: none; }
  }
</style>

<!-- The fun bits: postbox drop zone, route trace, and the "posted" moment. Global because log.ts builds some of it. -->
<style is:global>
  /* Postbox drop zone. The file input covers the whole box, so tapping and dropping both work natively. */
  .postbox {
    position: relative;
    display: grid;
    justify-items: center;
    gap: 0.9rem;
    padding: 1.6rem 1.2rem 1.4rem;
    border-radius: 60px 60px 12px 12px;
    background: linear-gradient(180deg, #d42b22 0%, #b31f18 100%);
    color: #fff;
    text-align: center;
    cursor: pointer;
    box-shadow: inset 0 -6px 0 rgba(0, 0, 0, 0.18), 0 10px 24px rgba(120, 20, 15, 0.22);
    transition: transform 0.2s ease, box-shadow 0.2s ease;
  }
  .postbox-input { position: absolute; inset: 0; width: 100%; height: 100%; opacity: 0; cursor: pointer; }
  .postbox:hover, .postbox.over { transform: translateY(-3px); box-shadow: inset 0 -6px 0 rgba(0, 0, 0, 0.18), 0 16px 32px rgba(120, 20, 15, 0.3); }
  .postbox:has(.postbox-input:focus-visible) { outline: 3px solid var(--fell); outline-offset: 4px; }
  .postbox-plate {
    font-size: 0.7rem; font-weight: 800; letter-spacing: 0.25em;
    padding: 0.15rem 0.7rem; border: 1.5px solid rgba(255, 255, 255, 0.7); border-radius: 3px;
  }
  .postbox-slot {
    position: relative;
    display: block;
    width: min(220px, 80%);
    height: 14px;
    border-radius: 7px;
    background: #1a1512;
    box-shadow: inset 0 3px 4px rgba(0, 0, 0, 0.7), 0 2px 0 rgba(255, 255, 255, 0.25);
    transition: height 0.2s ease;
  }
  .postbox.over .postbox-slot { height: 20px; }
  .postbox-letter {
    position: absolute; left: 50%; bottom: 7px; width: 70px; height: 44px; margin-left: -35px;
    background: #fbf8f0; border-radius: 3px; opacity: 0;
    background-image: linear-gradient(155deg, transparent 49%, #d8d3c4 50%, transparent 51%), linear-gradient(25deg, transparent 49%, #d8d3c4 50%, transparent 51%);
    clip-path: inset(0 0 0 0);
  }
  .postbox.over .postbox-letter { opacity: 1; transform: translateY(-10px) rotate(-4deg); transition: all 0.2s ease; }
  .postbox.dropped .postbox-letter { animation: drop-in 0.7s ease-in forwards; }
  @keyframes drop-in {
    0% { opacity: 1; transform: translateY(-40px) rotate(-6deg); clip-path: inset(0 0 0 0); }
    60% { opacity: 1; transform: translateY(0) rotate(0); clip-path: inset(0 0 0 0); }
    100% { opacity: 1; transform: translateY(44px); clip-path: inset(0 0 100% 0); }
  }
  .postbox-text { display: grid; gap: 0.2rem; }
  .postbox-text strong { font-size: 1.1rem; }
  .postbox-text span { font-size: 0.9rem; color: #ffe1dd; }
  .postbox.has-file .postbox-text strong::before { content: '✉ '; }

  /* GPX result card */
  .gpx-card { position: relative; margin-top: 1rem; border: 1px solid var(--line); border-radius: 12px; background: var(--paper-2); padding: 1rem 1.1rem 1.1rem; overflow: hidden; }
  .gpx-card.ok { border-color: color-mix(in srgb, var(--fell) 45%, var(--line)); }
  .gpx-track { display: block; width: 100%; height: auto; max-height: 220px; margin-bottom: 0.6rem; }
  .gpx-track .trace { fill: none; stroke: var(--red); stroke-width: 2.5; stroke-linecap: round; stroke-linejoin: round; stroke-dasharray: 1; stroke-dashoffset: 1; animation: draw 2.2s ease-out forwards; }
  .gpx-track .home { fill: var(--fell); }
  .gpx-track .home-label { fill: var(--fell); font-size: 11px; font-weight: 700; font-family: var(--sans); }
  @keyframes draw { to { stroke-dashoffset: 0; } }
  .gpx-stats { display: flex; flex-wrap: wrap; gap: 0.4rem 1.4rem; margin: 0 0 0.6rem; }
  .gpx-stats div { display: grid; }
  .gpx-stats b { font-family: var(--serif); font-size: 1.5rem; font-weight: 800; color: var(--fell); line-height: 1.1; }
  .gpx-stats span { font-size: 0.8rem; color: var(--ink-soft); }
  .gpx-head { font-weight: 700; margin: 0 0 0.4rem; }
  .gpx-card.ok .gpx-head { color: var(--fell); }
  .gpx-card.no .gpx-head { color: var(--red); }
  .deliveries { list-style: none; padding: 0; margin: 0; display: grid; gap: 0.3rem; }
  .deliveries li { display: flex; gap: 0.5rem; align-items: center; opacity: 0; animation: tick-in 0.35s ease-out forwards; animation-delay: calc(0.5s + var(--i) * 0.25s); }
  .deliveries .mark { display: grid; place-items: center; width: 1.3rem; height: 1.3rem; border-radius: 50%; font-size: 0.75rem; font-weight: 800; color: #fff; background: var(--fell); flex: none; }
  .deliveries li.fail .mark { background: var(--red); }
  @keyframes tick-in { from { opacity: 0; transform: translateX(-8px); } to { opacity: 1; transform: none; } }
  .frank {
    position: absolute; bottom: 1rem; right: 1rem;
    width: 92px; height: 92px; border-radius: 50%;
    border: 3px double var(--fell); color: var(--fell);
    display: grid; place-content: center; text-align: center; line-height: 1.05;
    font-size: 0.6rem; font-weight: 800; letter-spacing: 0.12em;
    transform: rotate(-14deg) scale(1); opacity: 0.85;
    animation: thunk 0.4s cubic-bezier(0.3, 1.6, 0.5, 1) both; animation-delay: calc(0.6s + var(--n) * 0.25s);
  }
  .frank strong { font-size: 0.85rem; letter-spacing: 0.06em; margin: 0.15rem 0; }
  @keyframes thunk { from { opacity: 0; transform: rotate(-14deg) scale(2.2); } to { opacity: 0.85; transform: rotate(-14deg) scale(1); } }

  .gpx-filled { margin: 0.8rem 0 0; padding: 0.6rem 0.8rem; border-radius: 8px; background: var(--paper); font-size: 0.92rem; color: var(--ink); max-width: calc(100% - 100px); }
  @media (max-width: 560px) {
    .gpx-filled { max-width: none; }
    .frank { top: 0.6rem; bottom: auto; right: 0.6rem; width: 76px; height: 76px; }
  }
  /* Fields filled in from the GPX glow briefly. */
  .filled { animation: filled 1.8s ease-out; border-radius: 6px; }
  @keyframes filled { 0%, 30% { box-shadow: 0 0 0 3px color-mix(in srgb, var(--moss) 70%, transparent); } 100% { box-shadow: 0 0 0 3px transparent; } }

  /* Photo preview, pinned like a snapshot */
  .snap { margin: 0.8rem 0 0; display: inline-block; background: #fff; padding: 6px 6px 18px; box-shadow: 0 6px 16px rgba(20, 30, 18, 0.18); transform: rotate(-2deg); border-radius: 2px; }
  .snap[hidden] { display: none; }
  .snap img { display: block; width: 150px; height: 110px; object-fit: cover; }

  /* The "posted" moment */
  .posted { background: var(--paper); border-radius: 12px; padding: 2rem 1.6rem; box-shadow: 0 18px 44px rgba(20, 30, 18, 0.1); text-align: center; outline: none; }
  .posted h2 { color: var(--fell); }
  .posted-actions { display: flex; flex-wrap: wrap; gap: 0.8rem; justify-content: center; margin: 1.2rem 0 0; }
  .posted-scene { position: relative; height: 210px; width: 240px; margin: 0 auto 1rem; }
  .chute { position: absolute; left: 0; right: 0; top: 0; height: 120px; overflow: hidden; }
  .posted-letter {
    position: absolute; left: 50%; top: 0; width: 96px; height: 62px; margin-left: -48px;
    background: #fbf8f0; border-radius: 4px; box-shadow: 0 3px 8px rgba(0, 0, 0, 0.18);
    background-image: linear-gradient(150deg, transparent 49%, #d8d3c4 50%, transparent 51%), linear-gradient(30deg, transparent 49%, #d8d3c4 50%, transparent 51%);
    animation: post-it 1.3s cubic-bezier(0.5, 0, 0.8, 0.4) 0.2s both;
  }
  .posted-letter span { position: absolute; top: 6px; right: 6px; width: 16px; height: 20px; background: #c4241c; border-radius: 1px; }
  @keyframes post-it {
    0% { transform: translateY(-70px) rotate(-12deg); }
    45% { transform: translateY(8px) rotate(0); }
    100% { transform: translateY(100px) rotate(0); }
  }
  .pillar {
    position: absolute; left: 50%; top: 80px; width: 150px; height: 130px; margin-left: -75px;
    background: linear-gradient(180deg, #d42b22, #a81d16); border-radius: 75px 75px 8px 8px;
    box-shadow: inset 0 -8px 0 rgba(0, 0, 0, 0.18);
    animation: wobble 0.4s ease-in-out 1.05s both;
  }
  .pillar-slot { position: absolute; left: 26px; right: 26px; top: 36px; height: 12px; border-radius: 6px; background: #1a1512; box-shadow: inset 0 3px 4px rgba(0, 0, 0, 0.7); }
  .pillar-plate { position: absolute; left: 50%; transform: translateX(-50%); top: 72px; font-size: 0.7rem; font-weight: 800; letter-spacing: 0.25em; color: #fff; border: 1.5px solid rgba(255, 255, 255, 0.7); border-radius: 3px; padding: 0.1rem 0.5rem; }
  @keyframes wobble { 0%, 100% { transform: rotate(0); } 30% { transform: rotate(-2.5deg); } 70% { transform: rotate(2deg); } }
  .posted-frank {
    position: absolute; right: -24px; top: 96px; width: 96px; height: 96px; border-radius: 50%;
    border: 3px double var(--fell); color: var(--fell);     display: grid; place-content: center; line-height: 1.05; font-size: 0.6rem; font-weight: 800; letter-spacing: 0.12em;
    animation: thunk 0.45s cubic-bezier(0.3, 1.6, 0.5, 1) 1.5s both;
  }
  .posted-frank strong { font-size: 0.78rem; letter-spacing: 0.05em; margin: 0.15rem 0; }

  @media (prefers-reduced-motion: reduce) {
    .postbox, .postbox-letter, .postbox-slot { transition: none; }
    .postbox.dropped .postbox-letter, .posted-letter { animation: none; opacity: 0; }
    .gpx-track .trace { animation: none; stroke-dashoffset: 0; }
    .deliveries li, .frank, .pillar, .posted-frank, .filled { animation: none; opacity: 1; }
    .frank { opacity: 0.85; }
  }
</style>
