---
import ContentPage from '../components/ContentPage.astro';
import Photo from '../components/Photo.astro';
import { STORY_PHOTOS } from '../lib/photos.ts';
---
<ContentPage id="story" banner="story">
  <div class="photo-pair">
    {STORY_PHOTOS.map((p) => <Photo photo={p} sizes="(min-width: 800px) 520px, 100vw" />)}
  </div>
  <div class="book" style="margin-top:3rem">
    <div class="book-card">
      <strong>The Postal Paths</strong>
      Rediscovering Britain’s forgotten trails and the people who walked them
      <div class="author">Alan Cleaver</div>
      <div>Monoray, 2025</div>
    </div>
    <div>
      <p>Ready to follow in the postie’s footsteps?</p>
      <p><a class="btn" href="/route/">See the route</a></p>
    </div>
  </div>
</ContentPage>
