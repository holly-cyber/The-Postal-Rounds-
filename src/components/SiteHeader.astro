---
import { SITE } from '../lib/config.ts';

const NAV = [
  { href: '/story/', label: 'The story' },
  { href: '/birchwood-cafe/', label: 'The café' },
  { href: '/route/', label: 'The route' },
  { href: '/safety/', label: 'Safety' },
  { href: '/post/', label: 'Post your round' },
  { href: '/round-book/', label: 'Round book' },
  { href: '/faq/', label: 'FAQ' },
  { href: '/contact/', label: 'Contact' },
];
const here = Astro.url.pathname.replace(/\/?$/, '/');
---
<header class="site-head">
  <div class="wrap bar">
    <a class="brand" href="/"><svg class="brand-stamp" viewBox="0 0 28 34" width="28" height="34" aria-hidden="true">
        <mask id="brand-perf"><rect width="28" height="34" fill="#fff" /><g fill="#000"><circle cx="2" cy="0" r="1.5"/><circle cx="2" cy="34" r="1.5"/><circle cx="6" cy="0" r="1.5"/><circle cx="6" cy="34" r="1.5"/><circle cx="10" cy="0" r="1.5"/><circle cx="10" cy="34" r="1.5"/><circle cx="14" cy="0" r="1.5"/><circle cx="14" cy="34" r="1.5"/><circle cx="18" cy="0" r="1.5"/><circle cx="18" cy="34" r="1.5"/><circle cx="22" cy="0" r="1.5"/><circle cx="22" cy="34" r="1.5"/><circle cx="26" cy="0" r="1.5"/><circle cx="26" cy="34" r="1.5"/><circle cx="0" cy="2" r="1.5"/><circle cx="28" cy="2" r="1.5"/><circle cx="0" cy="6" r="1.5"/><circle cx="28" cy="6" r="1.5"/><circle cx="0" cy="10" r="1.5"/><circle cx="28" cy="10" r="1.5"/><circle cx="0" cy="14" r="1.5"/><circle cx="28" cy="14" r="1.5"/><circle cx="0" cy="18" r="1.5"/><circle cx="28" cy="18" r="1.5"/><circle cx="0" cy="22" r="1.5"/><circle cx="28" cy="22" r="1.5"/><circle cx="0" cy="26" r="1.5"/><circle cx="28" cy="26" r="1.5"/><circle cx="0" cy="30" r="1.5"/><circle cx="28" cy="30" r="1.5"/><circle cx="0" cy="34" r="1.5"/><circle cx="28" cy="34" r="1.5"/></g></mask>
        <g mask="url(#brand-perf)">
          <rect width="28" height="34" rx="1" fill="#c4241c" />
          <rect x="4" y="4" width="20" height="26" fill="none" stroke="#fbf8f0" stroke-width="1" />
          <rect x="8" y="13" width="12" height="8.5" rx="0.8" fill="#fbf8f0" />
          <path d="M8.4 13.6 14 18l5.6-4.4" fill="none" stroke="#c4241c" stroke-width="1.1" stroke-linejoin="round" />
        </g>
      </svg>{SITE.name}</a>
    <nav aria-label="Main">
      <ul>
        {NAV.map((n) => <li><a href={n.href} aria-current={here === n.href ? 'page' : undefined}>{n.label}</a></li>)}
      </ul>
    </nav>
  </div>
</header>
