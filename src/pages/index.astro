---
import Base from '../layouts/Base.astro';
import ThemeToggle from '../components/ThemeToggle.astro';
import SketchMap from '../components/SketchMap.astro';
import { LIMITS, ROUND, STOPS } from '../lib/config.ts';
import { todayInShap } from '../lib/rounds.ts';

const today = todayInShap();
---
<Base
  title="The Shap Postal Round"
  description="Walk or run the last walked postal round in Shap, Cumbria — an 18 km loop from Birchwood Cafe, from Alan Cleaver's book The Postal Paths."
>
  <header class="site-head">
    <div class="wrap bar">
      <a class="brand" href="#top">The Shap Postal Round</a>
      <nav aria-label="Sections">
        <a href="#book">The book</a>
        <a href="#round">The round</a>
        <a href="#log">Log your round</a>
        <a href="#roundbook">Round book</a>
      </nav>
      <ThemeToggle />
    </div>
  </header>

  <main id="main">
    <!-- Hero -->
    <div class="hero" id="top">
      <div class="wrap hero-inner">
        <p class="eyebrow">Shap, Cumbria · {ROUND.nominalKm} km loop</p>
        <h1>The Shap Postal Round</h1>
        <p class="lede">
          For generations the post in Shap went out on foot. Walk or run the last walked round — out to Swindale,
          down to Wet Sleddale and home — starting and finishing at Birchwood Cafe on Main Street.
        </p>
        <div class="cta">
          <a class="btn" href="#round">See the round</a>
          <a class="btn ghost" href="#log">Log your round</a>
        </div>
      </div>
    </div>

    <!-- The book -->
    <section id="book" aria-labelledby="book-h">
      <div class="wrap two">
        <div>
          <p class="eyebrow">The book</p>
          <h2 id="book-h"><cite>The Postal Paths</cite></h2>
          <p>
            Alan Cleaver's <cite>The Postal Paths</cite> (Monoray, 2025) follows the routes postmen and women walked
            to reach farms and hamlets that no van could. Shap's round is one of the last to have been walked.
          </p>
          <p>
            Birchwood Cafe is where the round starts and ends. The owner's father was one of the last postmen to walk
            it.
          </p>
        </div>
        <div class="book-card card" aria-hidden="true">
          <div class="pillar"><span></span></div>
          <p class="book-title">The Postal Paths</p>
          <p class="book-author">Alan Cleaver</p>
        </div>
      </div>
    </section>

    <!-- The round -->
    <section id="round" aria-labelledby="round-h">
      <div class="wrap">
        <p class="eyebrow">The round</p>
        <h2 id="round-h">About {ROUND.nominalKm} km, eight stops</h2>
        <div class="round-grid">
          <SketchMap />
          <ol class="stops">
            {
              STOPS.map((s) => (
                <li>
                  <span class="stop-n" aria-hidden="true">{s.n}</span>
                  <div>
                    <h3>{s.name}</h3>
                    <p>{s.note}</p>
                  </div>
                </li>
              ))
            }
          </ol>
        </div>
        <aside class="safety card" aria-labelledby="safety-h">
          <h3 id="safety-h">Before you go</h3>
          <p>
            This is open fell country. Weather on the tops changes fast and paths can be faint. Carry OS Explorer OL5,
            a compass and waterproofs, and know how to use them. Tell someone your route and when you expect to be
            back. Keep dogs on leads near livestock, leave gates as you find them, and respect private land around
            the farms.
          </p>
        </aside>
      </div>
    </section>

    <!-- Log your round -->
    <section id="log" aria-labelledby="log-h">
      <div class="wrap">
        <p class="eyebrow">Log your round</p>
        <h2 id="log-h">Done it? Put your name in the book</h2>
        <p class="lede">
          Upload a GPX file and we check it straight away. No GPX? Add a link or a photo and we'll check it by hand.
        </p>

        <form id="round-form" class="card form" novalidate>
          <div class="row">
            <label for="f-name">Your name <span class="req">(required)</span></label>
            <input id="f-name" name="name" type="text" required maxlength={LIMITS.nameMax} autocomplete="name" />
          </div>

          <fieldset class="row">
            <legend>Did you walk or run? <span class="req">(required)</span></legend>
            <div class="choices">
              <label><input type="radio" name="mode" value="walk" checked /> Walk</label>
              <label><input type="radio" name="mode" value="run" /> Run</label>
            </div>
          </fieldset>

          <div class="row">
            <label for="f-date">Date <span class="req">(required)</span></label>
            <input id="f-date" name="date" type="date" required max={today} min={LIMITS.earliestDate} data-today />
          </div>

          <fieldset class="row">
            <legend>Your time <span class="req">(required)</span></legend>
            <div class="time">
              <label for="f-hours">Hours</label>
              <input id="f-hours" name="hours" type="number" inputmode="numeric" min="0" max="24" step="1" required />
              <label for="f-minutes">Minutes</label>
              <input id="f-minutes" name="minutes" type="number" inputmode="numeric" min="0" max="59" step="1" required />
            </div>
          </fieldset>

          <fieldset class="row evidence">
            <legend>Evidence — at least one</legend>

            <div class="row">
              <label for="f-gpx">GPX file</label>
              <input id="f-gpx" name="gpx" type="file" accept=".gpx,application/gpx+xml,application/xml,text/xml" aria-describedby="gpx-help" />
              <p id="gpx-help" class="help">Up to 10 MB. Checked instantly here, then again when you submit.</p>
              <div id="gpx-result" class="gpx-result" aria-live="polite"></div>
            </div>

            <div class="row">
              <label for="f-link">Link to your activity</label>
              <input id="f-link" name="link" type="url" inputmode="url" placeholder="https://" maxlength={LIMITS.linkMax} aria-describedby="link-help" />
              <p id="link-help" class="help">For example Strava or a blog post. Must start with https://</p>
            </div>

            <div class="row">
              <label for="f-photo">Photo</label>
              <input id="f-photo" name="photo" type="file" accept="image/jpeg,image/png,image/webp" aria-describedby="photo-help" />
              <p id="photo-help" class="help">JPEG, PNG or WebP, up to 8 MB. Only we see it — it's never published.</p>
            </div>
          </fieldset>

          <div class="row">
            <label for="f-note">A short note <span class="opt">(optional)</span></label>
            <textarea id="f-note" name="note" rows="2" maxlength={LIMITS.noteMax} aria-describedby="note-count"></textarea>
            <p id="note-count" class="help" aria-live="polite">{LIMITS.noteMax} characters left</p>
          </div>

          <div class="hp" aria-hidden="true">
            <label for="f-website">Leave this empty</label>
            <input id="f-website" name="website" type="text" tabindex="-1" autocomplete="off" />
          </div>

          <p class="help">
            Your name, time, date, link and note appear in the round book. GPX files and photos stay private.
          </p>

          <div class="actions">
            <button class="btn" type="submit">Add me to the round book</button>
          </div>
          <div id="form-status" class="status" role="status" aria-live="polite"></div>
        </form>
      </div>
    </section>

    <!-- The round book -->
    <section id="roundbook" aria-labelledby="rb-h">
      <div class="wrap">
        <p class="eyebrow">The round book</p>
        <h2 id="rb-h">Who's done the round</h2>
        <div class="tabs" role="tablist" aria-label="Round book views">
          <button role="tab" id="tab-date" aria-controls="rb-panel" aria-selected="true" data-view="date">By date</button>
          <button role="tab" id="tab-run" aria-controls="rb-panel" aria-selected="false" tabindex="-1" data-view="run">Fastest runs</button>
          <button role="tab" id="tab-walk" aria-controls="rb-panel" aria-selected="false" tabindex="-1" data-view="walk">Fastest walks</button>
        </div>
        <div id="rb-panel" role="tabpanel" aria-labelledby="tab-date" tabindex="0">
          <p class="help" id="rb-note"></p>
          <div id="rb-body"><p>Loading the round book…</p></div>
        </div>
      </div>
    </section>
  </main>

  <footer class="site-foot">
    <div class="wrap">
      <p>
        Inspired by <cite>The Postal Paths</cite> by Alan Cleaver (Monoray, 2025). Start and finish at Birchwood Cafe,
        Main Street, Shap CA10 3NJ.
      </p>
      <p class="help">Walk at your own risk. The sketch map is not to scale — use OS Explorer OL5 and a compass.</p>
    </div>
  </footer>

  <script>
    import '../scripts/home.ts';
  </script>
</Base>

<style>
  .site-head {
    background: var(--fell);
    color: #fff;
    position: sticky;
    top: 0;
    z-index: 5;
  }
  .bar {
    display: flex;
    align-items: center;
    gap: 1rem;
    padding-top: 0.6rem;
    padding-bottom: 0.6rem;
    flex-wrap: wrap;
  }
  .brand {
    font: 800 1.25rem var(--serif);
    color: #fff;
    text-decoration: none;
    margin-right: auto;
  }
  .site-head nav { display: flex; gap: 1rem; flex-wrap: wrap; }
  .site-head nav a { color: #fff; text-decoration: none; font-weight: 500; }
  .site-head nav a:hover { text-decoration: underline; color: #fff; }
  .site-head :focus-visible { outline-color: #fff; }
  @media (max-width: 720px) {
    .site-head nav { display: none; }
  }

  .hero {
    background:
      radial-gradient(ellipse at 80% 120%, color-mix(in srgb, var(--moss) 35%, transparent), transparent 60%),
      linear-gradient(170deg, var(--fell), #1f331d);
    color: #fff;
    padding: clamp(4rem, 14vw, 9rem) 0 clamp(3rem, 10vw, 6rem);
  }
  .hero h1 { color: #fff; }
  .hero .eyebrow { color: #ffb3ad; }
  .hero .lede { color: #dfe7d6; }
  .cta { display: flex; gap: 0.75rem; flex-wrap: wrap; margin-top: 1.5rem; }
  .hero .btn { background: var(--red); border-color: var(--red); color: #fff; }
  .hero .btn.ghost { background: transparent; border-color: #fff; color: #fff; }
  .hero .btn:hover { background: #fff; color: var(--fell); border-color: #fff; }
  .hero :focus-visible { outline-color: #fff; }

  .two {
    display: grid;
    gap: 2rem;
    grid-template-columns: 1fr;
    align-items: center;
  }
  @media (min-width: 800px) {
    .two { grid-template-columns: 3fr 2fr; }
  }
  .book-card {
    text-align: center;
    background: var(--fell);
    color: #fff;
    border: none;
    padding: 2.5rem 1.5rem;
    max-width: 22rem;
    justify-self: center;
    width: 100%;
  }
  .pillar {
    width: 56px;
    height: 110px;
    margin: 0 auto 1.25rem;
    background: var(--red);
    border-radius: 28px 28px 4px 4px;
    position: relative;
  }
  .pillar span {
    position: absolute;
    left: 12px;
    right: 12px;
    top: 40px;
    height: 6px;
    background: #1b1b1b;
    border-radius: 3px;
  }
  .book-title { font: 800 1.7rem var(--serif); margin: 0; }
  .book-author { color: #dfe7d6; margin: 0.25rem 0 0; }

  .round-grid {
    display: grid;
    gap: 2rem;
    grid-template-columns: 1fr;
    margin: 1.5rem 0 2rem;
  }
  @media (min-width: 900px) {
    .round-grid { grid-template-columns: 1.2fr 1fr; align-items: start; }
  }
  .stops { list-style: none; margin: 0; padding: 0; display: grid; gap: 1rem; }
  .stops li { display: grid; grid-template-columns: 2.25rem 1fr; gap: 0.75rem; }
  .stops h3 { margin: 0.1rem 0 0.2rem; font-size: 1.15rem; }
  .stops p { margin: 0; color: var(--muted); }
  .stop-n {
    width: 2.25rem;
    height: 2.25rem;
    border-radius: 50%;
    background: var(--accent);
    color: var(--on-accent);
    display: grid;
    place-items: center;
    font-weight: 700;
  }
  .stops li:first-child .stop-n { background: var(--red); color: #fff; }
  .safety { border-left: 6px solid var(--red); }
  .safety p { margin: 0; }

  .form { display: grid; grid-template-columns: minmax(0, 1fr); gap: 1.25rem; max-width: 42rem; margin-top: 1.5rem; }
  .row { display: grid; grid-template-columns: minmax(0, 1fr); gap: 0.35rem; }
  fieldset { border: 0; padding: 0; margin: 0; min-width: 0; }
  legend { font-weight: 700; padding: 0; margin-bottom: 0.35rem; }
  label { font-weight: 700; }
  .req, .opt { font-weight: 400; color: var(--muted); font-size: 0.9em; }
  input[type='text'], input[type='url'], input[type='date'], input[type='number'], textarea {
    font: inherit;
    color: var(--text);
    background: var(--bg);
    border: 1.5px solid var(--line);
    border-radius: 8px;
    padding: 0.6rem 0.75rem;
    width: 100%;
    min-height: 44px;
  }
  input[type='file'] { font: inherit; width: 100%; min-width: 0; }
  input:focus-visible, textarea:focus-visible { border-color: var(--accent); }
  input[aria-invalid='true'] { border-color: var(--bad); }
  .choices { display: flex; gap: 1.5rem; }
  .choices label { font-weight: 500; display: inline-flex; align-items: center; gap: 0.4rem; min-height: 44px; }
  .choices input { width: 1.2rem; height: 1.2rem; accent-color: var(--accent); }
  .time { display: grid; grid-template-columns: auto 1fr auto 1fr; gap: 0.5rem; align-items: center; }
  .time label { font-weight: 500; }
  .evidence { border: 1.5px dashed var(--line); border-radius: var(--radius); padding: 1rem; display: grid; grid-template-columns: minmax(0, 1fr); gap: 1rem; }
  .evidence legend { padding: 0 0.4rem; }
  .help { font-size: 0.95rem; color: var(--muted); margin: 0; }
  .hp { position: absolute; left: -9999px; width: 1px; height: 1px; overflow: hidden; }
  .status:empty { display: none; }
  .status { padding: 0.75rem 1rem; border-radius: 8px; border: 1.5px solid currentColor; }
  .status.ok { color: var(--ok); }
  .status.err { color: var(--bad); }
  .gpx-result:empty { display: none; }

  .tabs { display: flex; gap: 0.5rem; flex-wrap: wrap; margin: 1.5rem 0 1rem; }
  .tabs button {
    font: 700 1rem var(--sans);
    padding: 0.55rem 1rem;
    min-height: 44px;
    border-radius: 999px;
    border: 1.5px solid var(--accent);
    background: transparent;
    color: var(--accent);
    cursor: pointer;
  }
  .tabs button[aria-selected='true'] { background: var(--accent); color: var(--on-accent); }

  .site-foot { background: var(--fell); color: #dfe7d6; padding: 2.5rem 0; }
  .site-foot .help { color: #c3cfb8; }
  .site-foot :focus-visible { outline-color: #fff; }
</style>
