---
/**
 * Round book admin. Not linked anywhere, noindex. Everything is fetched with the admin bearer token.
 * Three views (hash routes): #overview (stats), #rounds (check, verify, remove), #contacts (emails).
 */
import Base from '../layouts/Base.astro';
import { SITE } from '../lib/config.ts';
---
<Base title="Round book admin" noindex bare>
  <!-- Sign in -->
  <main id="login-screen" class="login-screen">
    <form id="login" class="login-card">
      <p class="login-brand"><span class="stamp-mark" aria-hidden="true"></span>{SITE.name}</p>
      <h1>Round book admin</h1>
      <label for="token">Admin password</label>
      <input id="token" type="password" autocomplete="current-password" required />
      <button class="btn red" type="submit">Sign in</button>
      <p id="login-status" class="login-status" role="status" aria-live="polite"></p>
    </form>
  </main>

  <!-- Signed in -->
  <div id="app" hidden>
    <header class="admin-bar">
      <div class="wrap admin-bar-inner">
        <p class="admin-brand"><span class="stamp-mark" aria-hidden="true"></span>Round book admin</p>
        <nav class="admin-tabs" aria-label="Admin">
          <a href="#overview" data-tab="overview">Overview</a>
          <a href="#rounds" data-tab="rounds">Rounds</a>
          <a href="#contacts" data-tab="contacts">Contacts</a>
        </nav>
        <div class="admin-actions">
          <a class="btn small ghost" href="/round-book/" target="_blank" rel="noopener">View round book</a>
          <button class="btn small ghost" id="refresh" type="button">Refresh</button>
          <button class="btn small ghost" id="logout" type="button">Sign out</button>
        </div>
      </div>
    </header>

    <main id="main" class="wrap admin-main">
      <p id="status" class="status" role="status" aria-live="polite"></p>

      <!-- Overview -->
      <section id="view-overview" data-view="overview" aria-labelledby="ov-h">
        <h1 id="ov-h">Overview</h1>
        <div class="ov-tiles" id="ov-tiles"></div>
        <div class="ov-grid">
          <div class="panel">
            <h2>Rounds posted by month</h2>
            <div id="ov-months" class="months"></div>
            <div id="ov-months-axis" class="months-axis" aria-hidden="true"></div>
          </div>
          <div class="panel">
            <h2>Records</h2>
            <dl id="ov-records" class="ov-facts"></dl>
          </div>
          <div class="panel">
            <h2>Who’s doing it</h2>
            <dl id="ov-people" class="ov-facts"></dl>
          </div>
          <div class="panel">
            <h2>Latest rounds</h2>
            <ol id="ov-latest" class="latest"></ol>
          </div>
        </div>
      </section>

      <!-- Rounds -->
      <section id="view-rounds" data-view="rounds" aria-labelledby="rd-h" hidden>
        <h1 id="rd-h">Rounds</h1>
        <div class="toolbar">
          <div class="chips" role="group" aria-label="Show">
            <button type="button" data-filter="all" aria-pressed="true">All</button>
            <button type="button" data-filter="checked" aria-pressed="false">Passed the check</button>
            <button type="button" data-filter="waiting" aria-pressed="false">Didn’t pass</button>
          </div>
          <label class="search"><span class="sr-only">Search rounds</span><input id="rd-search" type="search" placeholder="Search name or email" /></label>
        </div>
        <p id="rd-summary" class="muted"></p>
        <div id="rd-list"></div>
      </section>

      <!-- Contacts -->
      <section id="view-contacts" data-view="contacts" aria-labelledby="ct-h" hidden>
        <h1 id="ct-h">Contacts</h1>
        <p class="muted">
          Everyone who has posted a round, one row per email address. Emails are private: use them only to follow up
          about a round. Messages from the contact page arrive in your{' '}
          <a href="https://app.netlify.com/projects/the-postal-rounds/forms" target="_blank" rel="noopener">Netlify Forms inbox</a>.
        </p>
        <div class="toolbar">
          <label class="search"><span class="sr-only">Search contacts</span><input id="ct-search" type="search" placeholder="Search name or email" /></label>
          <button class="btn small ghost" id="ct-copy" type="button">Copy all emails</button>
          <button class="btn small ghost" id="ct-csv" type="button">Download CSV</button>
        </div>
        <div class="table-wrap">
          <table class="ct-table">
            <thead>
              <tr><th scope="col">Name</th><th scope="col">Email</th><th scope="col">Rounds</th><th scope="col">Latest round</th><th scope="col">Best time</th></tr>
            </thead>
            <tbody id="ct-rows"></tbody>
          </table>
        </div>
        <p id="ct-empty" class="muted" hidden>No contacts yet.</p>
      </section>
    </main>
  </div>

  <script>
    import '../scripts/admin.ts';
  </script>
</Base>

<style is:global>
  [hidden] { display: none !important; }
  body { font-family: var(--sans); }
  .stamp-mark {
    display: inline-block; width: 18px; height: 22px; background: var(--red); border-radius: 2px;
    outline: 2px dotted var(--paper); outline-offset: -4px; transform: rotate(-6deg); flex: none;
  }

  /* Sign in */
  .login-screen { min-height: 100svh; display: grid; place-items: center; padding: 16px; background: var(--paper-2); }
  .login-card {
    width: min(100%, 24rem); display: grid; gap: 0.7rem; padding: 2rem 1.75rem;
    background: var(--paper); border: 1px solid var(--line); border-radius: 14px; box-shadow: 0 18px 44px rgba(20, 30, 18, 0.1);
  }
  .login-brand, .admin-brand { display: flex; align-items: center; gap: 0.55rem; margin: 0; font-family: var(--serif); font-weight: 800; color: var(--fell); }
  .login-card h1 { font-size: 1.9rem; color: var(--fell); margin: 0.2rem 0 0.6rem; }
  .login-card label { font-weight: 700; }
  .login-card input, .search input {
    font: inherit; padding: 0.65rem 0.75rem; border-radius: 8px; border: 1.5px solid var(--line); background: var(--paper); color: var(--ink);
  }
  .login-status { margin: 0; color: var(--red); min-height: 1.4em; }

  /* Bar */
  .admin-bar { position: sticky; top: 0; z-index: 5; background: var(--paper); border-bottom: 1px solid var(--line); }
  .admin-bar-inner { display: flex; flex-wrap: wrap; align-items: center; gap: 0.6rem 1.5rem; padding-top: 0.7rem; padding-bottom: 0.7rem; }
  .admin-tabs { display: flex; gap: 0.3rem; }
  .admin-tabs a { padding: 0.45rem 0.9rem; border-radius: 999px; text-decoration: none; color: var(--ink); font-weight: 600; }
  .admin-tabs a[aria-current='page'] { background: var(--fell); color: #fff; }
  .admin-tabs .count { display: inline-grid; place-items: center; min-width: 1.4rem; height: 1.4rem; padding: 0 0.35rem; margin-left: 0.2rem; border-radius: 999px; background: var(--red); color: #fff; font-size: 0.78rem; }
  .admin-actions { display: flex; flex-wrap: wrap; gap: 0.5rem; margin-left: auto; }

  .admin-main { padding-top: 2rem; padding-bottom: 4rem; }
  .admin-main h1 { color: var(--fell); font-size: clamp(1.8rem, 4vw, 2.6rem); margin-bottom: 1.2rem; }
  .admin-main h2 { font-size: 1.1rem; color: var(--fell); margin: 0 0 0.9rem; }
  .muted { color: var(--ink-soft); }
  .status { margin: 0; color: var(--red); }

  /* Overview */
  .admin-main section { padding: 0; border-top: 0; }
  .ov-tiles { display: grid; grid-template-columns: repeat(auto-fill, minmax(150px, 1fr)); gap: 0.8rem; margin-bottom: 1.4rem; }
  .tile { background: var(--paper-2); border-radius: 12px; padding: 1rem 1.1rem; }
  .tile .n { display: block; font-family: var(--serif); font-weight: 800; font-size: 2rem; line-height: 1.1; color: var(--fell); }
  .tile .l { display: block; color: var(--ink-soft); font-size: 0.9rem; margin-top: 0.2rem; }
  .tile.alert .n { color: var(--red); }
  a.tile { color: inherit; text-decoration: none; display: block; }
  a.tile:hover { background: color-mix(in srgb, var(--red) 8%, var(--paper-2)); }
  .ov-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(300px, 1fr)); gap: 1rem; }
  .panel { border: 1px solid var(--line); border-radius: 12px; padding: 1.2rem 1.3rem; background: var(--paper); }
  .ov-facts { display: grid; grid-template-columns: auto 1fr; gap: 0.55rem 1rem; margin: 0; }
  .ov-facts dt { color: var(--ink-soft); }
  .ov-facts dd { margin: 0; font-weight: 600; text-align: right; }
  .latest { list-style: none; margin: 0; padding: 0; display: grid; gap: 0.55rem; }
  .latest li { display: flex; flex-wrap: wrap; justify-content: space-between; gap: 0.1rem 1rem; }
  .latest strong { white-space: nowrap; }
  .latest span { color: var(--ink-soft); }

  /* Rounds by month: one series, one hue, value on hover and in each bar's label */
  .months { display: flex; align-items: flex-end; gap: 2px; height: 160px; padding-top: 1.4rem; border-bottom: 1px solid var(--line); }
  .months .col { position: relative; flex: 1; display: flex; flex-direction: column; justify-content: flex-end; height: 100%; min-width: 0; }
  .months .bar { background: var(--moss); border-radius: 4px 4px 0 0; min-height: 2px; }
  .months .col:hover .bar, .months .col:focus-visible .bar { background: var(--fell); }
  .months .val { position: absolute; left: 50%; transform: translate(-50%, -1.3rem); bottom: var(--h); font-size: 0.78rem; font-weight: 700; color: var(--ink); opacity: 0; }
  .months .col:hover .val, .months .col:focus-visible .val, .months .col.last .val { opacity: 1; }
  .months-axis { display: flex; gap: 2px; margin-top: 0.35rem; font-size: 0.72rem; color: var(--ink-soft); }
  .months-axis span { flex: 1; text-align: center; min-width: 0; overflow: hidden; }

  /* Rounds */
  .toolbar { display: flex; flex-wrap: wrap; gap: 0.7rem; align-items: center; margin-bottom: 1rem; }
  .chips { display: flex; flex-wrap: wrap; gap: 0.35rem; }
  .chips button { font: inherit; font-weight: 600; padding: 0.45rem 0.9rem; border-radius: 999px; border: 1.5px solid var(--line); background: var(--paper); color: var(--ink); cursor: pointer; }
  .chips button[aria-pressed='true'] { background: var(--fell); border-color: var(--fell); color: #fff; }
  .search { margin-left: auto; }
  .search input { min-width: 16rem; }
  .entry { border: 1px solid var(--line); border-radius: 12px; padding: 1.1rem 1.2rem; margin-bottom: 0.8rem; background: var(--paper); display: grid; gap: 0.45rem; }
  .entry-head { display: flex; flex-wrap: wrap; align-items: baseline; gap: 0.4rem 0.8rem; }
  .entry-head h2 { font-size: 1.25rem; margin: 0; color: var(--ink); }
  .entry p { margin: 0; }
  .entry .meta { color: var(--ink-soft); }
  .entry .checks { list-style: none; margin: 0.2rem 0 0; padding: 0; display: flex; flex-wrap: wrap; gap: 0.3rem 1rem; font-size: 0.92rem; }
  .entry .checks .pass { color: var(--moss); }
  .entry .checks .fail { color: var(--red); }
  .entry .buttons { display: flex; flex-wrap: wrap; gap: 0.5rem; margin-top: 0.3rem; }
  .entry .danger { border-color: var(--red); color: var(--red); background: transparent; }
  .entry .photo { max-width: 100%; max-height: 420px; border-radius: 8px; }

  /* Contacts */
  .table-wrap { overflow-x: auto; border: 1px solid var(--line); border-radius: 12px; }
  .ct-table { width: 100%; border-collapse: collapse; }
  .ct-table th, .ct-table td { text-align: left; padding: 0.7rem 0.9rem; border-bottom: 1px solid var(--line); white-space: nowrap; }
  .ct-table th { background: var(--paper-2); font-size: 0.85rem; color: var(--ink-soft); }
  .ct-table tr:last-child td { border-bottom: 0; }

  @media (max-width: 700px) {
    .admin-actions { margin-left: 0; }
    .search { margin-left: 0; width: 100%; }
    .search input { min-width: 0; width: 100%; }
  }
</style>
