---
/** Renders one of the editable pages in src/content/pages/. */
import { getEntry, render } from 'astro:content';
import Base from '../layouts/Base.astro';
import PageBanner from './PageBanner.astro';
import type { PAGE_PHOTOS } from '../lib/photos.ts';

interface Props {
  id: string;
  banner?: keyof typeof PAGE_PHOTOS;
  kicker?: string;
}
const entry = await getEntry('pages', Astro.props.id);
if (!entry) throw new Error(`Missing src/content/pages/${Astro.props.id}.md`);
const { Content } = await render(entry);
---
<Base title={entry.data.title} description={entry.data.description}>
  <main id="main">
    <PageBanner page={Astro.props.banner} title={entry.data.title} lede={entry.data.lede} kicker={Astro.props.kicker} />
    <slot name="band" />
    <div class="wrap page-body">
      <slot name="before" />
      <div class="prose"><Content /></div>
      <slot />
    </div>
    <slot name="after" />
  </main>
</Base>
