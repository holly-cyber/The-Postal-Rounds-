---
import ContentPage from '../components/ContentPage.astro';

// AdventureSmart UK's three questions, verbatim.
const QUESTIONS = [
  'Do I have the right gear?',
  'Do I know what the weather will be like?',
  'Am I confident I have the knowledge and skills for the day?',
];
---
<ContentPage id="safety" kicker="Before you go" banner="safety">
  <section slot="band" class="band-fell tight" aria-labelledby="q-h">
    <div class="wrap">
      <p class="label-kicker on-dark">AdventureSmart UK</p>
      <h2 id="q-h">Three questions before you set off</h2>
      <ol class="questions">
        {
          QUESTIONS.map((q, i) => (
            <li>
              <span class="q-n" aria-hidden="true">{i + 1}</span>
              <p>{q}</p>
            </li>
          ))
        }
      </ol>
      <p class="q-note">If the answer to any of them is no, save the round for another day.</p>
    </div>
  </section>
</ContentPage>

<style>
  .questions { list-style: none; margin: 1.6rem 0 1rem; padding: 0; display: grid; grid-template-columns: repeat(3, 1fr); gap: 1rem; }
  .questions li { background: rgba(255, 255, 255, 0.07); border: 1px solid rgba(255, 255, 255, 0.16); border-radius: 12px; padding: 1.4rem; }
  .q-n { display: block; font-family: var(--serif); font-weight: 800; font-size: 3rem; line-height: 1; color: #ff8f86; margin-bottom: 0.6rem; }
  .questions p { font-family: var(--serif); font-weight: 700; font-size: 1.3rem; line-height: 1.3; color: #fff; margin: 0; }
  .q-note { margin: 0; }
  @media (max-width: 800px) { .questions { grid-template-columns: 1fr; } }
</style>
