---
/**
 * Hand-drawn style sketch of the loop, drawn from the STOPS in config.ts.
 * Deliberately not a real map: the caption says so.
 */
import { OS_MAP, STOPS } from '../lib/config.ts';

const W = 640;
const H = 520;
const PAD_X = 150;
const PAD_Y = 60;

const lats = STOPS.map((s) => s.lat);
const lons = STOPS.map((s) => s.lon);
const minLat = Math.min(...lats);
const maxLat = Math.max(...lats);
const minLon = Math.min(...lons);
const maxLon = Math.max(...lons);
const kx = Math.cos(((minLat + maxLat) / 2) * (Math.PI / 180));
const spanX = (maxLon - minLon) * kx;
const spanY = maxLat - minLat;
const scale = Math.min((W - 2 * PAD_X) / spanX, (H - 2 * PAD_Y) / spanY);
const offX = (W - spanX * scale) / 2;
const offY = (H - spanY * scale) / 2;

const pts = STOPS.map((s) => ({
  ...s,
  x: offX + (s.lon - minLon) * kx * scale,
  y: offY + (maxLat - s.lat) * scale,
}));

// Closed Catmull-Rom spline through the stops, as cubic Béziers.
const n = pts.length;
let d = `M ${pts[0].x.toFixed(1)} ${pts[0].y.toFixed(1)}`;
for (let i = 0; i < n; i++) {
  const p0 = pts[(i - 1 + n) % n];
  const p1 = pts[i];
  const p2 = pts[(i + 1) % n];
  const p3 = pts[(i + 2) % n];
  const c1x = p1.x + (p2.x - p0.x) / 6;
  const c1y = p1.y + (p2.y - p0.y) / 6;
  const c2x = p2.x - (p3.x - p1.x) / 6;
  const c2y = p2.y - (p3.y - p1.y) / 6;
  d += ` C ${c1x.toFixed(1)} ${c1y.toFixed(1)}, ${c2x.toFixed(1)} ${c2y.toFixed(1)}, ${p2.x.toFixed(1)} ${p2.y.toFixed(1)}`;
}

// Label placement per stop (config `side`), defaulting to away from the centre.
function labelAt(p: (typeof pts)[number]) {
  const side = p.side ?? (p.x < W / 2 ? 'left' : 'right');
  if (side === 'left') return { x: p.x - 22, y: p.y + 5, anchor: 'end' };
  if (side === 'right') return { x: p.x + 22, y: p.y + 5, anchor: 'start' };
  if (side === 'above') return { x: p.x, y: p.y - 22, anchor: 'middle' };
  return { x: p.x, y: p.y + 32, anchor: 'middle' };
}
---
<figure class="sketch">
  <svg viewBox={`0 0 ${W} ${H}`} role="img" aria-labelledby="map-title map-desc">
    <title id="map-title">Sketch map of the Shap postal round</title>
    <desc id="map-desc">
      A loop starting and finishing at Birchwood Cafe in Shap, heading west into Swindale, south to Wet
      Sleddale and back. Stops in order: {STOPS.map((s) => `${s.n}. ${s.name}`).join(', ')}. Not to scale.
    </desc>
    <path class="route-shadow" d={d} />
    <path class="route" d={d} />
    {
      pts.map((p) => {
        const l = labelAt(p);
        return (
        <g class={p.n === 1 ? 'stop home' : 'stop'}>
          <circle cx={p.x} cy={p.y} r={p.n === 1 ? 15 : 12} />
          <text class="num" x={p.x} y={p.y + 5} text-anchor="middle">
            {p.n}
          </text>
          <text class="name" x={l.x} y={l.y} text-anchor={l.anchor}>
            {p.label ?? p.name}
          </text>
        </g>
        );
      })
    }
    <g class="compass" transform={`translate(${W - 44} 48)`}>
      <path d="M0 -26 L8 6 L0 0 L-8 6 Z" />
      <text x="0" y="24" text-anchor="middle">N</text>
    </g>
  </svg>
  <figcaption>Not to scale — use {OS_MAP} and a compass.</figcaption>
</figure>

<style>
  .sketch {
    margin: 0;
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    padding: 0.75rem;
  }
  svg { display: block; width: 100%; }
  .route {
    fill: none;
    stroke: var(--red);
    stroke-width: 3.5;
    stroke-dasharray: 10 7;
    stroke-linecap: round;
  }
  .route-shadow {
    fill: none;
    stroke: var(--accent-2);
    stroke-opacity: 0.25;
    stroke-width: 16;
    stroke-linejoin: round;
  }
  .stop circle { fill: var(--accent); stroke: var(--surface); stroke-width: 3; }
  .stop.home circle { fill: var(--red); }
  .num { fill: var(--on-accent); font: 700 15px var(--sans); }
  .home .num { fill: #fff; }
  .name {
    fill: var(--text);
    font: 700 16px var(--sans);
    paint-order: stroke;
    stroke: var(--surface);
    stroke-width: 5px;
  }
  .compass path { fill: var(--accent); }
  .compass text { fill: var(--accent); font: 700 14px var(--sans); }
  figcaption {
    font-family: var(--serif);
    font-style: italic;
    color: var(--muted);
    text-align: center;
    padding-top: 0.5rem;
  }
</style>
