---
/**
 * Home page intro: the Stuart Lewis quote as the centrepiece on a fell-green band,
 * with the route facts on a postage-stamp card.
 */
import { ROUNDS } from '../lib/config.ts';
import Postmark from './Postmark.astro';
import Photo from './Photo.astro';
import { CAFE_PHOTO } from '../lib/photos.ts';

const tiles: [string, string, string][] = [
  [`${ROUNDS.long.km}`, 'km', 'long round'],
  [`${ROUNDS.short.km}`, 'km', 'short “winter” round'],
  ['600', 'm', 'of climb'],
  ['3–3½', 'hrs', 'at a steady run'],
];
const details: [string, string][] = [
  ['Start & finish', 'Birchwood Cafe, Main Street, Shap · NY 56268 15254'],
  ['Walking', 'Allow a full day. Tough in places.'],
  ['Terrain', 'Fields, lanes and rough, often pathless fell'],
  ['Map', 'OS Explorer OL5 and a compass'],
];
---
<section id="intro" class="band-fell intro-band" aria-labelledby="intro-h">
  <div class="wrap intro-grid">
    <div class="intro-story">
      <p class="label-kicker on-dark">The challenge</p>
      <h2 id="intro-h">Tougher than it looks.</h2>
      <p class="intro-lede">
        Traversing three remote Lake District valleys, the round will leave you with nothing but respect for the village
        postie.
      </p>

      <figure class="bigquote">
        <span class="qmark" aria-hidden="true">“</span>
        <blockquote>
          <p>
            It broke my heart. I loved the walk and went out in all weathers. There wasn’t a day when we didn’t complete
            the round even in mist, snow and ice.
          </p>
        </blockquote>
        <figcaption>
          <strong>Stuart Lewis</strong>
          <span>The last postman to walk the round, on being given a van in 1976</span>
        </figcaption>
      </figure>

      <a class="intro-link" href="/story/">Read the story of the round <span aria-hidden="true">→</span></a>
    </div>

    <aside class="stamp tilt" aria-labelledby="glance-h">
      <Postmark />

      <h3 id="glance-h" class="glance-title">Route at a glance</h3>
      <dl class="tiles">
        {
          tiles.map(([n, u, l]) => (
            <div>
              <dt>{l}</dt>
              <dd>
                {n}
                <small>{u}</small>
              </dd>
            </div>
          ))
        }
      </dl>
      <dl class="details">
        {
          details.map(([k, v]) => (
            <div>
              <dt>{k}</dt>
              <dd>{v}</dd>
            </div>
          ))
        }
      </dl>
      <a class="btn red stamp-cta" href="/route/">See the route</a>
    </aside>
  </div>

  <!-- Stacy's story. DRAFT from the build brief: check the wording with Stacy before launch. -->
  <div class="wrap stacy">
    <Photo photo={CAFE_PHOTO} class="stacy-photo" sizes="(min-width: 900px) 520px, 100vw" />
    <div class="stacy-text">
      <p class="label-kicker on-dark">Why it starts at Birchwood Cafe</p>
      <h2 id="stacy-h">Stacy’s story</h2>
      <p>
        Stacy’s family ran Shap’s post office and sorting office for generations. Growing up, the family sorted the post at
        six every morning, and her father was one of the last postmen to walk the round.
      </p>
      <p>
        Today Stacy runs Birchwood Cafe on Main Street, and the post office is still part of the furniture: an original post
        office counter, the old post office clock on the wall and a collection of postal memorabilia. The post always started
        here. So does the challenge.
      </p>
      <a class="intro-link" href="/birchwood-cafe/">About the café <span aria-hidden="true">→</span></a>
    </div>
  </div>
</section>

<style>
  .stacy {
    position: relative;
    display: grid;
    grid-template-columns: 1fr 1.1fr;
    gap: clamp(2rem, 5vw, 4rem);
    align-items: center;
    margin-top: clamp(3.5rem, 7vw, 5.5rem);
    padding-top: clamp(3rem, 6vw, 4.5rem);
    border-top: 1px solid rgba(238, 241, 232, 0.18);
  }
  .stacy :global(.stacy-photo img) { aspect-ratio: 4 / 3; border-radius: 12px; box-shadow: 0 24px 60px rgba(0, 0, 0, 0.35); }
  .stacy :global(.stacy-photo figcaption) { color: #b9c4b1; }
  .stacy h2 { color: #fff; font-size: clamp(2rem, 4vw, 2.8rem); font-weight: 800; }
  .stacy p { font-size: 1.08rem; }
  @media (max-width: 900px) { .stacy { grid-template-columns: 1fr; } }
</style>
