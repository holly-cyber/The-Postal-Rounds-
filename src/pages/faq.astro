---
/**
 * FAQ as open/close questions. Text still lives in src/content/pages/faq.md:
 * each "### Question" heading and the paragraphs under it become one item.
 */
import { getEntry } from 'astro:content';
import Base from '../layouts/Base.astro';
import PageBanner from '../components/PageBanner.astro';

const entry = await getEntry('pages', 'faq');
if (!entry?.body) throw new Error('Missing src/content/pages/faq.md');

const esc = (t: string) => t.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');
// Tiny markdown subset for answers: paragraphs, links, *italics* and **bold**.
const inline = (t: string) =>
  esc(t)
    .replace(/\[([^\]]+)\]\(([^)\s]+)\)/g, '<a href="$2">$1</a>')
    .replace(/\*\*([^*]+)\*\*/g, '<strong>$1</strong>')
    .replace(/\*([^*]+)\*/g, '<em>$1</em>');

const items = entry.body
  .split(/^### /m)
  .slice(1)
  .map((chunk) => {
    const [q, ...rest] = chunk.split('\n');
    const html = rest
      .join('\n')
      .trim()
      .split(/\n{2,}/)
      .map((p) => `<p>${inline(p.replace(/\n/g, ' '))}</p>`)
      .join('');
    return { q: q.trim(), html };
  });
---
<Base title={entry.data.title} description={entry.data.description}>
  <main id="main">
    <PageBanner page="faq" title="Your questions" kicker="FAQ" lede="Everything you need to know before you take on the Postman’s Challenge." />
    <div class="wrap page-body faq-wrap">
      <div class="faq-list">
        {
          items.map((it, i) => (
            <details open={i === 0}>
              <summary>{it.q}</summary>
              <div class="answer" set:html={it.html} />
            </details>
          ))
        }
      </div>
      <aside class="faq-side">
        <p class="label-kicker">Still stuck?</p>
        <h2>Ask us</h2>
        <p>Messages go to the volunteer who looks after the site, not the café.</p>
        <p><a class="btn red" href="/contact/">Get in touch</a></p>
      </aside>
    </div>
  </main>
</Base>

<style>
  .faq-wrap { display: grid; grid-template-columns: 1.6fr 1fr; gap: clamp(2rem, 5vw, 4rem); align-items: start; padding-bottom: 4rem; }
  .faq-list { display: grid; gap: 0.8rem; }
  details { background: var(--card); border: 1px solid var(--line); border-radius: 12px; overflow: hidden; }
  details[open] { background: var(--paper); box-shadow: 0 12px 30px rgba(20, 30, 18, 0.08); border-color: color-mix(in srgb, var(--fell) 30%, var(--line)); }
  summary {
    cursor: pointer;
    list-style: none;
    padding: 1.1rem 3.2rem 1.1rem 1.3rem;
    font-family: var(--serif);
    font-weight: 700;
    font-size: 1.15rem;
    color: var(--fell);
    position: relative;
  }
  summary::-webkit-details-marker { display: none; }
  summary::after {
    content: '+';
    position: absolute;
    right: 1.1rem;
    top: 50%;
    transform: translateY(-50%);
    width: 1.7rem;
    height: 1.7rem;
    border-radius: 50%;
    background: var(--red);
    color: #fff;
    display: grid;
    place-items: center;
    font-weight: 800;
  }
  details[open] summary::after { content: '–'; }
  .answer { padding: 0 1.3rem 1.1rem; }
  .answer :global(p:last-child) { margin-bottom: 0; }
  .faq-side { position: sticky; top: 1.5rem; background: var(--paper-2); border-radius: 12px; padding: 1.6rem; }
  .faq-side h2 { color: var(--fell); font-size: 1.8rem; }
  @media (max-width: 820px) { .faq-wrap { grid-template-columns: 1fr; } .faq-side { position: static; } }
</style>
