---
/** Instagram call-out: follow the café, share your round with the hashtag. Hidden if no Instagram URL is set. */
import { Picture } from 'astro:assets';
import { SITE } from '../lib/config.ts';
import { INSTAGRAM_TILES } from '../lib/photos.ts';
---
{
  SITE.instagram && (
    <section class="insta" aria-labelledby="insta-h">
      <div class="wrap">
        <div class="insta-head">
          <div>
            <p class="label-kicker">On Instagram</p>
            <h2 id="insta-h">Follow the café</h2>
            <p class="insta-sub">
              Share your round with <strong>{SITE.hashtag}</strong> and tag <strong>{SITE.instagramHandle}</strong>.
            </p>
          </div>
          <a class="btn red insta-btn" href={SITE.instagram} target="_blank" rel="noopener">
            <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true">
              <rect x="3" y="3" width="18" height="18" rx="5" fill="none" stroke="currentColor" stroke-width="2" />
              <circle cx="12" cy="12" r="4.2" fill="none" stroke="currentColor" stroke-width="2" />
              <circle cx="17.4" cy="6.6" r="1.3" fill="currentColor" />
            </svg>
            {SITE.instagramHandle}
          </a>
        </div>
        <ul class="insta-grid">
          {
            INSTAGRAM_TILES.map((t) => (
              <li>
                <a href={SITE.instagram} target="_blank" rel="noopener" aria-label={`${t.alt} Opens Birchwood Cafe on Instagram`}>
                  <Picture
                    src={t.src}
                    alt=""
                    formats={['avif', 'webp']}
                    widths={[300, 600]}
                    sizes="(min-width: 900px) 16vw, 33vw"
                    loading="lazy"
                    style={t.focus ? `object-position:${t.focus}` : undefined}
                  />
                </a>
              </li>
            ))
          }
        </ul>
      </div>
    </section>
  )
}

<style>
  .insta { border-top: 0; background: var(--paper-2); }
  .insta-head { display: flex; flex-wrap: wrap; gap: 1rem 2rem; align-items: flex-end; justify-content: space-between; margin-bottom: 1.5rem; }
  .insta-head h2 { color: var(--fell); margin-bottom: 0.3em; }
  .insta-sub { margin: 0; color: var(--ink-soft); }
  .insta-btn { display: inline-flex; align-items: center; gap: 0.55rem; }
  .insta-grid { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(6, 1fr); gap: 0.5rem; }
  .insta-grid a { display: block; position: relative; aspect-ratio: 1; overflow: hidden; border-radius: 8px; }
  .insta-grid :global(picture), .insta-grid :global(img) { display: block; width: 100%; height: 100%; }
  .insta-grid :global(img) { object-fit: cover; transition: transform 0.5s ease, filter 0.3s ease; }
  .insta-grid a:hover :global(img) { transform: scale(1.06); filter: saturate(1.15); }
  .insta-grid a::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(45deg, rgba(196, 36, 28, 0.25), transparent 60%);
    opacity: 0;
    transition: opacity 0.3s ease;
  }
  .insta-grid a:hover::after { opacity: 1; }
  @media (max-width: 700px) { .insta-grid { grid-template-columns: repeat(3, 1fr); } }
  @media (prefers-reduced-motion: reduce) { .insta-grid :global(img), .insta-grid a::after { transition: none; } }
</style>
